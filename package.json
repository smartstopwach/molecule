{
  "name": "jarvis-lab-ar-molecule-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JARVIS LAB \u2014 AR Molecule Builder: build molecules in 3D with webcam hand gestures.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "vite build && rm -rf site && mv dist site",
    "serve": "node scripts/serve-static.mjs 5173 site",
    "start": "npm run build:site && npm run serve",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "howler": "2.2.4",
    "postprocessing": "6.36.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.166.1",
    "zustand": "4.5.5"
  },
  "optionalDependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.20.0"
  },
  "devDependencies": {
    "@types/howler": "2.2.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.166.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "^30.1.2",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
