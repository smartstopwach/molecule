# Optional: host MediaPipe WASM + model yourself (recommended for offline/private deploys).
# Copy the wasm/ folder and hand_landmarker.task into /public/mediapipe and set:
# VITE_MEDIAPIPE_WASM_BASE=/mediapipe/wasm
# VITE_HAND_MODEL_URL=/mediapipe/hand_landmarker.task
# Defaults (CDN) are used when these are unset.
VITE_MEDIAPIPE_WASM_BASE=
VITE_HAND_MODEL_URL=
